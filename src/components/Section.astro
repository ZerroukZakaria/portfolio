---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---
<section id={id} class="mx-auto max-w-5xl scroll-mt-20 px-6 py-16 border-t border-border">
  <h2 class="font-mono text-sm uppercase tracking-widest text-accent">{title}</h2>
  <div class="mt-8">
    <slot />
  </div>
</section>