---
interface Props {
  id: string;
  line1: string;
  line2: string;
}
const { id, line1, line2 } = Astro.props;
---
<section id={id} class="scroll-mt-24 py-16 md:py-20">
  <h2 class="font-display text-5xl font-extrabold uppercase leading-[0.92] tracking-tight md:text-7xl">
    <span class="block">{line1}</span>{" "}
    <span class="block text-heading-2">{line2}</span>
  </h2>
  <div class="mt-10">
    <slot />
  </div>
</section>