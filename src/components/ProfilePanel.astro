---
import { site } from "../data/site";
---
<aside
  aria-label="Profile"
  class="-m-1 p-1 min-[900px]:sticky min-[900px]:top-20 min-[900px]:max-h-[calc(100dvh-7rem)] min-[900px]:self-start min-[900px]:overflow-y-auto"
>
  <div class="panel rounded-2xl bg-panel-bg p-6 text-panel-text">
    <p class="font-display text-3xl font-extrabold uppercase leading-[0.95] tracking-tight">
      Zakaria<br />Zerrouk
    </p>
    <p class="mt-4 font-semibold">Full-stack developer</p>
    <p class="text-sm text-panel-muted">Mohammedia, Morocco</p>
    <p class="mt-4 text-sm leading-relaxed text-panel-muted">
      Backend, integrations and real-time data systems.
    </p>
    <ul class="mt-5 grid gap-1 text-sm font-semibold">
      <li><a class="underline underline-offset-4" href={site.github} rel="noopener">GitHub</a></li>
      <li><a class="underline underline-offset-4" href={site.linkedin} rel="noopener">LinkedIn</a></li>
      <li><a class="underline underline-offset-4" href={`mailto:${site.email}`}>Email</a></li>
    </ul>
    <a
      href={site.cv}
      class="mt-5 block rounded bg-panel-text px-4 py-2 text-center text-sm font-semibold text-panel-bg hover:opacity-90"
    >
      Download CV
    </a>
  </div>
</aside>