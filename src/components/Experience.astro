---
import Section from "./Section.astro";
import { experience } from "../data/experience";
---
<Section id="experience" line1="Work" line2="Experience">
  <ol>
    {experience.map((job) => (
      <li class="grid gap-3 border-t border-border py-8 last:border-b md:grid-cols-[11rem_1fr] md:gap-8">
        <div class="font-mono text-xs uppercase tracking-widest text-muted">
          <p>{job.period}</p>
          <p class="mt-1 normal-case tracking-normal">{job.place}</p>
        </div>
        <div>
          <h3 class="text-xl font-semibold">{job.role}</h3>
          <p class="font-semibold text-accent-text">{job.company}</p>
          {job.summary && <p class="mt-2 text-muted">{job.summary}</p>}
          <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-accent-text">
            {job.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</Section>