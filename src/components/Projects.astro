---
import Section from "./Section.astro";
import { site } from "../data/site";

const tags = ["TypeScript", "React", "MapLibre", "MQTT", "PostgreSQL", "Docker"];
---
<Section id="projects" title="Selected projects">
  <article class="rounded-lg border border-border bg-surface p-6">
    <p class="font-mono text-xs text-muted">Independent project</p>
    <h3 class="mt-2 text-xl font-semibold">
      <a href="/projects/fleet-tracking-demo" class="hover:text-accent">Fleet tracking demo</a>
    </h3>
    <p class="mt-3 max-w-2xl text-muted">
      A simulated fleet and the logic that turns raw GPS positions into geofence
      alerts, trips, stops and reports. It runs in the browser, and as a Docker
      pipeline with MQTT and PostgreSQL. Original code, synthetic data.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs text-muted">
      {tags.map((t) => <li class="rounded border border-border px-2 py-1">{t}</li>)}
    </ul>
    <div class="mt-6 flex flex-wrap gap-3 text-sm">
      <a href="/projects/fleet-tracking-demo" class="rounded bg-accent px-4 py-2 font-semibold text-accent-ink hover:opacity-90">Case study</a>
      <a href={site.demo} rel="noopener" class="rounded border border-border px-4 py-2 font-semibold hover:border-accent">Live demo</a>
      <a href={site.demoRepo} rel="noopener" class="rounded border border-border px-4 py-2 font-semibold hover:border-accent">GitHub</a>
    </div>
  </article>
</Section>