---
import { site } from "../data/site";
---
<section id="top" class="pb-20 pt-10">
  <p class="font-mono text-sm text-muted">
    <span class="font-semibold text-text">{site.name}</span> · Mohammedia, Morocco
  </p>

  <h1 class="mt-4 max-w-3xl font-display text-4xl font-extrabold leading-[1.02] tracking-tight md:text-5xl">
    Full-stack developer building real-time, data-driven web applications.
  </h1>

  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
    I've built fleet-management and vehicle-tracking platforms: geolocation and
    geofencing logic, MQTT and Kafka data flows, APIs and reports. I'm open to
    full-stack and backend roles, on-site, hybrid or remote.
  </p>

  <div class="mt-8 flex flex-wrap gap-3">
    <a href="#projects" class="rounded bg-accent px-5 py-2.5 font-semibold text-accent-ink hover:opacity-90">
      View projects
    </a>
    <a href="#contact" class="rounded border border-border px-5 py-2.5 font-semibold hover:border-accent-text">
      Contact me
    </a>
        <a href={site.cv} download class="rounded border border-border px-5 py-2.5 font-semibold hover:border-accent-text">
      Download CV
    </a>
  </div>

  <ul class="mt-8 flex flex-wrap gap-6 font-mono text-sm text-muted">
    <li><a class="hover:text-text" href={site.github} rel="noopener">GitHub</a></li>
    <li><a class="hover:text-text" href={site.linkedin} rel="noopener">LinkedIn</a></li>
    <li><a class="hover:text-text" href={`mailto:${site.email}`}>Email</a></li>
  </ul>
</section>