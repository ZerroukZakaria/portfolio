---
import Section from "./Section.astro";
import { site } from "../data/site";
---
<Section id="contact" title="Contact">
  <p class="max-w-xl text-lg">
    I'm open to full-stack and backend roles in Mohammedia, Casablanca, Rabat
    or remote. The quickest way to reach me is by email.
  </p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a href={`mailto:${site.email}`} class="rounded bg-accent px-5 py-2.5 font-semibold text-accent-ink hover:opacity-90">
      {site.email}
    </a>
    <a href={site.linkedin} rel="noopener" class="rounded border border-border px-5 py-2.5 font-semibold hover:border-accent">LinkedIn</a>
    <a href={site.github} rel="noopener" class="rounded border border-border px-5 py-2.5 font-semibold hover:border-accent">GitHub</a>
  </div>
</Section>
<footer class="mx-auto max-w-5xl border-t border-border px-6 py-8 font-mono text-xs text-muted">
  © 2026 {site.name}
</footer>